# Variables usadas por docker-compose.yml al levantar los tres contenedores.
# Contrasena de PostgreSQL (opcional; si no se define, se usa una de desarrollo). Definela en un entorno real
# ANTES de crear el volumen de la base de datos por primera vez.
DB_PASSWORD=
SESSION_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
RESET_TOKEN_SECRET=cambia-este-valor-por-otro-secreto-largo-y-aleatorio
EMAIL_ADAPTER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Portal de Tutorias <no-responder@example.edu.co>
WEB_APP_URL=http://localhost:8080
