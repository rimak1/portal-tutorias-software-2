# Base de datos
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_tutorias?schema=public"

# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Sesion (cookie firmada)
SESSION_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
SESSION_COOKIE_NAME="portal_session"
SESSION_TTL_HORAS=12

# Token de restablecimiento de contrasena
RESET_TOKEN_SECRET="cambia-este-valor-por-otro-secreto-largo-y-aleatorio"
RESET_TOKEN_TTL_MINUTOS=30

# Correo (SMTP) - E-01, unica integracion externa permitida
SMTP_HOST="smtp.example.edu.co"
SMTP_PORT=587
SMTP_USER="no-responder@example.edu.co"
SMTP_PASSWORD="cambia-esta-clave"
SMTP_FROM="Portal de Tutorias <no-responder@example.edu.co>"
EMAIL_ADAPTER="mock"

# URL publica de la SPA (para armar el enlace de restablecimiento)
WEB_APP_URL="http://localhost:5173"
